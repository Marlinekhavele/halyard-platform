# Copy to .env and change the secrets before running anywhere but your laptop.

# Shared by all services to sign and verify sign-in tokens. Use 32+ random characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-before-deploying

POSTGRES_PASSWORD=halyard
RABBITMQ_PASSWORD=halyard

# Public address of the platform (links in emails, allowed CORS origin)
PUBLIC_URL=http://localhost:8080
HTTP_PORT=8080

# Create the demo company, users, ports and rates on first start
SEED_DEMO_DATA=true
ENVIRONMENT=development

# The tracking data provider sends this in the X-Tracking-Token header
TRACKING_WEBHOOK_TOKEN=dev-tracking-token

# Email. Defaults to Mailpit (catches all mail at http://localhost:8025).
# For production use your provider's SMTP, e.g. Postmark or Amazon SES.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Halyard <hello@halyard.example>

# Logging: DEBUG, INFO, WARNING or ERROR. Docker services log JSON.
LOG_LEVEL=INFO
