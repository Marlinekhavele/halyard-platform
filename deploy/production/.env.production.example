# Copy to .env.production, replace every example value, and never commit secrets.
# API_HOST must resolve to this Docker host; TCP 80 and 443 must be reachable.
API_HOST=api.example.com
PUBLIC_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
ACME_EMAIL=ops@example.com
HTTP_PORT=80
HTTPS_PORT=443

# Generate separate random values; URL-safe values work in the PostgreSQL URL.
# Example: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
RABBITMQ_PASSWORD=CHANGE_ME
TRACKING_WEBHOOK_TOKEN=dev-tracking-token

ENVIRONMENT=production
SEED_DEMO_DATA=false
LOG_LEVEL=INFO

# Use a real transactional email provider; these are placeholders only.
SMTP_HOST=smtp.provider.example
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
MAIL_FROM=Halyard <hello@example.com>
